#include <stdio.h>

#define ROWS 2
#define COLS 3

void transposeMatrix(int src[ROWS][COLS], int dest[COLS][ROWS]) {
    for (int r = 0; r < ROWS; r++) {
        for (int c = 0; c < COLS; c++) {
            // Swap row indices with column indices
            dest[c][r] = src[r][c];
        }
    }
}

int main() {
    int original[ROWS][COLS] = {
        {1, 2, 3},
        {4, 5, 6}
    };
    int result[COLS][ROWS];

    transposeMatrix(original, result);

    printf("--- Original Matrix (2x3) ---\n");
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) printf("%d ", original[i][j]);
        printf("\n");
    }

    printf("\n--- Transposed Matrix (3x2) ---\n");
    for (int i = 0; i < COLS; i++) {
        for (int j = 0; j < ROWS; j++) printf("%d ", result[i][j]);
        printf("\n");
    }

    return 0;
}
