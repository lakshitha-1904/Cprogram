#include <stdio.h>
#include <stdlib.h>

// Function prototypes
float calculateAverage(const float *array, int size);
float findHighest(const float *array, int size);

int main() {
    int capacity;
    float *temperatures = NULL;
    FILE *filePointer = NULL;

    printf("=== Dynamic Temperature Analyzer ===\n\n");
    printf("Enter the number of temperature logs you want to process: ");
    if (scanf("%d", &capacity) != 1 || capacity <= 0) {
        printf("Error: Invalid entry count.\n");
        return 1;
    }

    // Allocate memory dynamically based on user input
    temperatures = (float *)malloc(capacity * sizeof(float));
    if (temperatures == NULL) {
        printf("Error: Memory allocation failed!\n");
        return 1;
    }

    // Collect data points from the user
    printf("\nEnter %d temperature readings (in Celsius):\n", capacity);
    for (int i = 0; i < capacity; i++) {
        printf("Reading [%d]: ", i + 1);
        if (scanf("%f", &temperatures[i]) != 1) {
            printf("Error: Invalid floating-point value.\n");
            free(temperatures); // Free memory before an emergency exit
            return 1;
        }
    }

    // Perform processing logic using functions and pointers
    float avg = calculateAverage(temperatures, capacity);
    float high = findHighest(temperatures, capacity);

    // Display summary results in console
    printf("\n=== Analysis Complete ===\n");
    printf("Average Temperature: %.2f°C\n", avg);
    printf("Highest Temperature: %.2f°C\n", high);

    // Write the output to a text log file
    filePointer = fopen("temperature_report.txt", "w");
    if (filePointer == NULL) {
        printf("Error: Could not create output log file.\n");
    } else {
        fprintf(filePointer, "--- TEMPERATURE ANALYSIS REPORT ---\n");
        fprintf(filePointer, "Total Readings Analyzed: %d\n", capacity);
        fprintf(filePointer, "Average Value:           %.2f°C\n", avg);
        fprintf(filePointer, "Highest Peak Value:      %.2f°C\n", high);
        
        fclose(filePointer); // Safely close file stream
        printf("\nSuccessfully saved data analysis to 'temperature_report.txt'!\n");
    }

    // Always free dynamic memory allocations to prevent leaks
    free(temperatures);
    temperatures = NULL; 

    return 0;
}

// Function that parses an array using pointer arithmetic instead of brackets
float calculateAverage(const float *array, int size) {
    float sum = 0.0;
    for (int i = 0; i < size; i++) {
        sum += *(array + i); // Equivalent to array[i]
    }
    return sum / size;
}

// Function that finds the maximum value inside an array block
float findHighest(const float *array, int size) {
    float max = array[0];
    for (int i = 1; i < size; i++) {
        if (array[i] > max) {
            max = array[i];
        }
    }
    return max;
}
