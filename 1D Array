#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n;
    int sum = 0;
    
    // Read the size of the array
    if (scanf("%d", &n) != 1) {
        return 1;
    }
    
    // Dynamically allocate memory for the array on the heap
    int *arr = (int*)malloc(n * sizeof(int));
    
    // Safety check to ensure memory was allocated successfully
    if (arr == NULL) {
        return 1;
    }
    
    // Read space-separated values into the array
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    // Iterate through the array to calculate the sum of all elements
    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }
    
    // Print the calculated sum
    printf("%d\n", sum);
    
    // Deallocate the dynamic memory
    free(arr);
    
    return 0;
}
