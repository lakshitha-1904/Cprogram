#include <stdio.h>
#include <stdlib.h>

// Defining a simple structure to hold student data
struct Student {
    int roll_no;
    char name[50];
    float marks;
};

int main() {
    FILE *file;
    int num_students;

    // Step 1: Open file in write-binary mode ("wb") to clear old data and write fresh records
    file = fopen("students.dat", "wb");
    if (file == NULL) {
        printf("Error opening file for writing!\n");
        return 1;
    }

    printf("Enter the number of students to register: ");
    scanf("%d", &num_students);

    // Dynamically allocate memory for the requested number of students
    struct Student *s = (struct Student*) malloc(num_students * sizeof(struct Student));
    if (s == NULL) {
        printf("Memory allocation failed!\n");
        fclose(file);
        return 1;
    }

    // Input data from the user
    for (int i = 0; i < num_students; i++) {
        printf("\n--- Entering Details for Student %d ---\n", i + 1);
        printf("Enter Roll Number: ");
        scanf("%d", &s[i].roll_no);
        printf("Enter Name (No spaces): ");
        scanf("%s", s[i].name);
        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);

        // Write the individual structure block directly into the file
        fwrite(&s[i], sizeof(struct Student), 1, file);
    }

    fclose(file); // Close the file after writing
    free(s);      // Free the temporary memory array
    printf("\nData successfully written to 'students.dat'!\n");

    // Step 2: Open the file in read-binary mode ("rb") to verify the contents
    file = fopen("students.dat", "rb");
    if (file == NULL) {
        printf("Error opening file for reading!\n");
        return 1;
    }

    struct Student temp; // Temporary single structure variable to read into
    printf("\n--- Reading Data From Saved File ---\n");
    printf("%-10s %-20s %-5s\n", "Roll No", "Name", "Marks");
    printf("------------------------------------------\n");

    // fread loops through the file, reading one structure block at a time until EOF (End of File)
    while (fread(&temp, sizeof(struct Student), 1, file) == 1) {
        printf("%-10d %-20s %-5.2f\n", temp.roll_no, temp.name, temp.marks);
    }

    fclose(file); // Always close the file handle when finished
    return 0;
}
